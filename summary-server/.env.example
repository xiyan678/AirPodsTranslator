HOST=127.0.0.1
PORT=3001
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Only enable behind a local reverse proxy that overwrites X-Real-IP.
TRUST_PROXY=1
REQUESTS_PER_IP_HOUR=600
REQUESTS_PER_DAY=2000
MAX_CONCURRENT=4
# Must match the Apple developer team that signs the iPhone app.
APPLE_TEAM_ID=
DEVICECHECK_KEY_ID=
DEVICECHECK_KEY_FILE=/www/wwwroot/ear-yi-summary/devicecheck.p8
# Ad Hoc / App Store builds use production; Xcode development builds use development.
DEVICECHECK_ENVIRONMENT=production
